# Copie este archivo como .env y ajuste los valores. NO contiene secretos reales.

# --- Persistencia ---
# Local: SQLite en archivo. Docker Compose sobrescribe esta variable para usar PostgreSQL.
# Render: pegar la "Internal Database URL" de la base PostgreSQL (postgres://...).
DATABASE_URL=sqlite:///./cleanpro.db
POSTGRES_USER=cleanpro
POSTGRES_PASSWORD=cleanpro_dev_pwd
POSTGRES_DB=cleanpro_db

# --- Políticas de negocio (RN) ---
MAX_DESCUENTO_COORDINADOR=10.0
MAX_M2_COORDINADOR=300.0
MAX_MONTO_COORDINADOR=8000.0
RENDIMIENTO_M2_PERSONA_HORA=60.0
TARIFA_POR_M2=25.0
HORAS_CANCELACION_SIN_COSTO=24
MAX_REPROGRAMACIONES_MES=2
SLA_RESPUESTA_HORAS=4.0

# --- Zona horaria de operación (Monterrey, UTC-6) ---
ZONA_HORARIA_OFFSET_HORAS=-6
